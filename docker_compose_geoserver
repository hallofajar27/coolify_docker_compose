services:
  geoserver:
    image: 'kartoza/geoserver:2.28.5'
    networks:
      - coolify
    expose:
      - '8080'
    volumes:
      - 'geoserver_data:/opt/geoserver/data_dir'
    environment:
      GEOSERVER_ADMIN_USER: '${GEOSERVER_ADMIN_USER:-admin}'
      GEOSERVER_ADMIN_PASSWORD: '${GEOSERVER_ADMIN_PASSWORD:-geoserver}'
      INITIAL_MEMORY: '${INITIAL_MEMORY:-1G}'
      MAXIMUM_MEMORY: '${MAXIMUM_MEMORY:-2G}'
      CORS_ENABLED: 'true'
      CORS_ALLOWED_ORIGINS: '*'
      CORS_ALLOWED_METHODS: 'GET,POST,PUT,DELETE,HEAD,OPTIONS'
      CORS_ALLOWED_HEADERS: '*'
      ROOT_WEBAPP_REDIRECT: 'true'
      PROXY_BASE_URL: 'https://gs.sinaugis.my.id/geoserver'
      GEOSERVER_CSRF_WHITELIST: 'gs.sinaugis.my.id'
    restart: unless-stopped
    healthcheck:
      test:
        - CMD-SHELL
        - "curl --fail --silent -u ${GEOSERVER_ADMIN_USER:-admin}:${GEOSERVER_ADMIN_PASSWORD:-geoserver} http://localhost:8080/geoserver/rest/about/version.xml || exit 1"
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 120s

volumes:
  geoserver_data:

networks:
  coolify:
    external: true



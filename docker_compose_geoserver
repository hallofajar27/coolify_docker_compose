version: '3.8'
services:
  geoserver:
    image: 'kartoza/geoserver:latest'
    container_name: geoserver_app

    volumes:
      - 'geoserver_data:/opt/geoserver/data_dir'
    environment:
      GEOSERVER_ADMIN_USER: '${GEOSERVER_ADMIN_USER:-admin}'
      GEOSERVER_ADMIN_PASSWORD: '${GEOSERVER_ADMIN_PASSWORD:-geoserver}'
      INITIAL_MEMORY: '${INITIAL_MEMORY:-1G}'
      MAXIMUM_MEMORY: '${MAXIMUM_MEMORY:-2G}'
      CORS_ENABLED: 'true'
      CORS_ALLOWED_ORIGINS: '*'
      CORS_ALLOWED_METHODS: 'GET,POST,PUT,DELETE,HEAD,OPTIONS'
      CORS_ALLOWED_HEADERS: '*'
      PROXY_BASE_URL: 'https://gs.hallofajar.my.id/geoserver'
      GEOSERVER_CSRF_WHITELIST: gs.hallofajar.my.id
    restart: unless-stopped
    healthcheck:
      test:
        - CMD-SHELL
        - 'curl -f http://localhost:8080/geoserver/web/ || exit 1'
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 90s
volumes:
  geoserver_data:
    name: geoserver_data_volume

